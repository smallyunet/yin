(record Point [x Int] [y Int])
(record Problem [message String])
(define total
  (fun ([values (Vector Int)] [-> Int])
    (fold values 0 (fun ([sum Int] [value Int] [-> Int]) (+ sum value)))))
(define describe
  (fun ([value (U Point Problem)] [-> String])
    (match value
      [(Point x y) (concat (to-string x) (to-string y))]
      [(Problem message) message])))
[(total (filter (range 1 10) (fun ([value Int] [-> Bool]) (> value 5))))
  (describe (Point :x 4 :y 2))]
